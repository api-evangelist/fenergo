{
  "openapi": "3.0.1",
  "info": {
    "title": "Fenergo Nebula Identity - Self-Service Management Query",
    "description": "**Self-Service Management Query API**:\n\n<br> The Self-Service Management Query API provides methods to retrieve Users, Clients and their information per Tenant. Use the Self-Service Management Command API to create and manage user and client data. \n\n<br> **Self-Service Management Query API provides**:<br><ul><li> The ability to query for All Users within a single Tenant.</li><li> The ability to query for Single User Details by User Id within a given Tenant.</li><li> The ability to query for All Clients within a single Tenant.</li><li> The ability to query for Single Client Details by Client Id within a given Tenant.</li><li> The ability to query for All Secrets within a single Client.</li><li> The ability to query for Single Secret by Secret Id within a given Client.</li><li> The ability to query for All Scopes a Client can have assigned.</li></ul>",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "/identitymanagementquery"
    }
  ],
