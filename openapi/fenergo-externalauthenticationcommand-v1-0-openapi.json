        ],
        "description": "<br /><br /><b>Required permissions:</b><br />Following permissions are required: ExternalAuthenticationDelete",
        "operationId": "DeleteConfiguration",
        "parameters": [
          {
            "name": "configurationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
